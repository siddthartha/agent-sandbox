#!/bin/bash

# Claude Code keeps its config, sessions and memory in ~/.claude and its
# global settings in ~/.claude.json on the host. Create them first: docker
# creates a missing bind-mount source as a root-owned directory, which breaks
# Claude Code on the host as well. An empty JSON object is a valid fresh
# ~/.claude.json.
mkdir -p "$HOME/.claude"
[ -f "$HOME/.claude.json" ] || echo '{}' > "$HOME/.claude.json"

# Optional host files, each mounted read-only and only if it exists, because
# bind-mounting a missing path makes docker create a directory there on the
# host and break the tool that owns it. ~/.gitconfig gives git the user's
# identity; known_hosts covers every ssh server the host already trusts beyond
# GitHub's keys baked into the image (claude.Dockerfile).
extra_args=()
if [ -f "$HOME/.gitconfig" ]; then
  extra_args+=(-v "$HOME/.gitconfig:/home/node/.gitconfig:ro")
fi
if [ -f "$HOME/.ssh/known_hosts" ]; then
  extra_args+=(-v "$HOME/.ssh/known_hosts:/home/node/.ssh/known_hosts:ro")
fi

# The ssh-agent socket, so git over ssh works without copying any key. On
# Linux the host socket is mounted as is. On macOS a socket cannot cross the
# VM boundary; Docker Desktop and OrbStack forward the host agent inside the
# VM at /run/host-services/ssh-auth.sock instead. Skipped when no agent runs,
# because docker rejects an empty mount source.
agent_sock="$SSH_AUTH_SOCK"
if [ "$(uname -s)" = Darwin ]; then
  agent_sock=/run/host-services/ssh-auth.sock
fi
if [ -n "$agent_sock" ]; then
  extra_args+=(-v "$agent_sock:/tmp/ssh-agent.sock" -e SSH_AUTH_SOCK=/tmp/ssh-agent.sock)
fi

# Run as the host user (not root) so files written to /workspace keep host
# ownership. An explicit uid:gid drops the image's supplementary groups, so
# the `docker` group from claude.Dockerfile is re-added for socket access.
# Arguments are passed through to the claude CLI.
docker run -it --rm \
  --user "$(id -u):$(id -g)" \
  --group-add docker \
  -v "$(pwd):/workspace" \
  -v "$HOME/.claude:/home/node/.claude" \
  -v "$HOME/.claude.json:/home/node/.claude.json" \
  -v "/var/run/docker.sock:/var/run/docker.sock" \
  "${extra_args[@]}" \
  -w /workspace \
  claude-sandbox "$@"
